# --- Database (PostgreSQL). On Supabase + Vercel (see docs/DEPLOY.md):
# DATABASE_URL = Transaction pooler (port 6543) + "?pgbouncer=true&connection_limit=1"
# DIRECT_URL   = Session pooler (port 5432), used for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

# --- Private file storage (images, videos, generated audio).
# "local" writes to STORAGE_DIR (a server with a disk). "supabase" uses a private Supabase
# Storage bucket (needed on Vercel). The service role key stays on the server, never in the browser.
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
# STORAGE_DRIVER="supabase"
# SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_BUCKET="media"
# Largest video a teacher can upload, in MB (default 500). Supabase Free allows 50 MB per file.
VIDEO_MAX_MB="500"

# --- Text-to-speech (natural voices, generated once and cached). Pick one.
# TTS_PROVIDER="azure"
# TTS_PROVIDER="google"

# --- Speech recognition on the server. Leave unset to use Chrome's built-in recognizer.
# STT_PROVIDER="azure"     # recognition + pronunciation assessment
# STT_PROVIDER="google"
# STT_SPANISH_LOCALE="es-MX"   # es-MX | es-US | es-CO ... (what the provider receives for es-419)

# Microsoft Azure Speech (one key covers TTS and STT)
# AZURE_SPEECH_KEY=""
# AZURE_SPEECH_REGION="eastus"

# Google Cloud (Text-to-Speech and/or Speech-to-Text APIs enabled on the key)
# GOOGLE_CLOUD_API_KEY=""

# --- Optional grammar checker (teacher text only). Public API or self-hosted LanguageTool.
# LANGUAGETOOL_API_URL="https://api.languagetool.org/v2"
# LANGUAGETOOL_USERNAME=""
# LANGUAGETOOL_API_KEY=""

# --- Email (Resend, https://resend.com): password reset, email verification, admin invitation and
# the automatic English emails (welcome, subscription activated, payment confirmed). Verify your
# domain in Resend first, then set both. Each automatic email is sent once (EmailLog table).
# RESEND_API_KEY=""
# EMAIL_FROM="LaxtroSpeak <no-reply@YOUR-DOMAIN>"
# Public address used in email links (on Vercel the production domain is used automatically).
# APP_URL="https://speakandlearnspanish.com"
# EMAIL_DRIVER="console"   # tests only: print emails to the server log. Never in production.

# --- LaxtroSpeak administrators (Admin panel: Add Content, Library, Manage Activities).
# A listed email gets the ADMIN role on the server once that email is verified. Comma separated.
# Another way, without redeploying: npm run admin:grant -- someone@example.com
#   (verified account → admin now · unverified → verification email · no account → invitation)
# ADMIN_EMAILS=""

# --- Payments (Stripe). Use TEST keys (sk_test_…) on Preview. Live keys are refused unless
# VERCEL_ENV=production and STRIPE_ALLOW_LIVE=1.
# Webhook endpoint: https://YOUR-DOMAIN/api/billing/webhook with the events
#   checkout.session.completed, customer.subscription.created, customer.subscription.updated,
#   customer.subscription.deleted, invoice.paid
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PRICE_ID="price_..."          # the recurring price of the teacher plan
# STRIPE_WEBHOOK_SECRET="whsec_..."    # from the webhook endpoint (or `stripe listen`)
# STRIPE_PLAN_NAME="LaxtroSpeak Teacher"
# STRIPE_ALLOW_LIVE="1"                # production only, when you are ready to charge

# --- Internet image search in the game editor (child-safe). Free key: https://pixabay.com/api/docs/
# PIXABAY_API_KEY=""
# Optional extra filter: Google Cloud Vision SafeSearch checks every image (Vision API enabled on the key).
# GOOGLE_VISION_API_KEY=""
