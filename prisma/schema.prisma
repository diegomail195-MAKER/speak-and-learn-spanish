// LextroSpeak (formerly Speak & Learn Spanish) — relational schema.
// Every tenant-owned row carries schoolId so data from different schools never mixes.
// Authorization is enforced in src/lib/auth + src/lib/access (server only).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
}

enum VideoSource {
  HOSTED
  YOUTUBE
}

enum EvaluationMode {
  PHRASE // full phrase or accepted alternative
  LETTERS // spelled letter by letter (Spanish letter names)
}

enum RecipientType {
  CLASSROOM
  LEVEL
  GROUP
  STUDENT
}

enum ResponseOutcome {
  CORRECT
  INCORRECT
  UNCERTAIN
}

enum SupportLevel {
  NONE // answered with no help
  HINT // after a hint
  MODEL // after hearing the correct model
}

enum LoginType {
  PIN // class code + name + 4-digit PIN
  PASSWORD // class code + name + password
}

// LextroSpeak grade bands (the levels the platform uses everywhere).
enum GradeBand {
  LOWER // Lower Elementary, grades K–2
  UPPER // Upper Elementary, grades 3–6
}

enum ResourceKind {
  VIDEO
  SONG
  FLASHCARDS
  GAME
  PRINTABLE
  WORKSHEET
}

enum MasteryStatus {
  INDEPENDENT
  GUIDED
  NEEDS_PRACTICE
}

model School {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users       User[]
  classrooms  Classroom[]
  categories  Category[]
  media       MediaAsset[]
  audio       AudioAsset[]
  games       Game[]
  videos      Video[]
  collections Collection[]
  assignments Assignment[]
  students    Student[]
  auditLogs   AuditLog[]
  keepWords   KeepWord[]
}

model User {
  id               String    @id @default(cuid())
  schoolId         String
  role             Role
  email            String?   @unique
  passwordHash     String?
  displayName      String
  // Set when the person opens the verification link (or accepts an admin invite).
  emailVerifiedAt  DateTime?
  // Set once, when the welcome email is claimed, so it is never sent twice.
  welcomeSentAt    DateTime?
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  school             School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  subscriptions      Subscription[]
  teacher            Teacher?
  student            Student?

  @@index([schoolId, role])
}

model Session {
  id        String   @id // sha256 of the cookie token, never the token itself
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Teacher {
  id       String @id @default(cuid())
  userId   String @unique
  schoolId String

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  classrooms  Classroom[]
  games       Game[]
  videos      Video[]
  assignments Assignment[]

  @@index([schoolId])
}

// Students get minimal personal data: first name + last initial, a username and a PIN.
model Student {
  id           String    @id @default(cuid())
  userId       String    @unique
  schoolId     String
  classroomId  String
  firstName    String
  lastInitial  String    @default("")
  // Optional, only used by the "Spell your name" activity.
  spellingName String    @default("")
  username     String
  // How the student signs in. The secret (PIN or password) is only stored hashed.
  loginType    LoginType @default(PIN)
  pinHash      String
  avatar       String    @default("sun")
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  school           School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroom        Classroom             @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  memberships      GroupMembership[]
  recipients       AssignmentRecipient[]
  attempts         StudentAttempt[]
  progress         ProgressRecord[]
  videoProgress    VideoProgress[]
  activityProgress ActivityProgress[]
  skillProgress    SkillProgress[]

  @@unique([classroomId, username])
  @@index([schoolId])
}

// A teacher's class. Students sign in with the class code.
model Classroom {
  id        String   @id @default(cuid())
  schoolId  String
  teacherId String
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  school     School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher    Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  levels     Level[]
  students   Student[]
  recipients AssignmentRecipient[]

  @@index([schoolId])
  @@index([teacherId])
}

model Level {
  id          String   @id @default(cuid())
  classroomId String
  name        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  classroom  Classroom             @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  groups     Group[]
  recipients AssignmentRecipient[]

  @@unique([classroomId, name])
}

model Group {
  id        String   @id @default(cuid())
  levelId   String
  name      String
  createdAt DateTime @default(now())

  level       Level                 @relation(fields: [levelId], references: [id], onDelete: Cascade)
  memberships GroupMembership[]
  recipients  AssignmentRecipient[]

  @@unique([levelId, name])
}

model GroupMembership {
  groupId   String
  studentId String
  createdAt DateTime @default(now())

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([groupId, studentId])
  @@index([studentId])
}

model Category {
  id        String   @id @default(cuid())
  schoolId  String
  parentId  String?
  nameEn    String
  nameEs    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  school   School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  games    Game[]
  videos   Video[]

  @@index([schoolId, parentId])
}

// Reusable uploaded file (image, video, audio). Files live in private storage and are
// streamed through an authorized route, never from a public bucket.
model MediaAsset {
  id           String    @id @default(cuid())
  schoolId     String
  ownerUserId  String?
  kind         MediaKind
  storageKey   String    @unique
  mimeType     String
  sizeBytes    Int
  originalName String
  sha256       String
  createdAt    DateTime  @default(now())

  school        School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  audio         AudioAsset[]
  itemImages    GameItem[]   @relation("ItemImage")
  videoFiles    Video[]      @relation("VideoFile")
  videoCovers   Video[]      @relation("VideoCover")
  videoCaptions Video[]      @relation("VideoCaptions")

  @@index([schoolId, kind])
  @@index([schoolId, sha256])
}

// Generated speech. cacheKey = hash(provider, voice, rate, style, text) so identical
// text is synthesized once per school.
model AudioAsset {
  id           String   @id @default(cuid())
  schoolId     String
  mediaAssetId String
  text         String
  language     String
  voice        String
  rate         Float    @default(1)
  style        String?
  provider     String
  cacheKey     String
  createdAt    DateTime @default(now())

  school School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  media  MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  promptFor   Question[] @relation("PromptAudio")
  hintFor     Question[] @relation("HintAudio")
  modelFor    Question[] @relation("ModelAudio")
  supportFor  Question[] @relation("SupportAudio")
  instructFor Game[]     @relation("InstructionAudio")

  @@unique([schoolId, cacheKey])
}

model Video {
  id               String        @id @default(cuid())
  schoolId         String
  teacherId        String
  title            String
  description      String        @default("")
  source           VideoSource
  fileAssetId      String?
  youtubeId        String?
  coverAssetId     String?
  categoryId       String?
  level            String        @default("")
  keywords         String[]
  durationSec      Int?
  status           ContentStatus @default(DRAFT)
  // Optional WebVTT subtitles (hosted videos). YouTube uses its own captions.
  captionsAssetId  String?
  captionsLanguage String        @default("es")
  // "Watch & Practice": game opened right after the video.
  practiceGameId   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher      Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  file         MediaAsset?       @relation("VideoFile", fields: [fileAssetId], references: [id], onDelete: SetNull)
  cover        MediaAsset?       @relation("VideoCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  captions     MediaAsset?       @relation("VideoCaptions", fields: [captionsAssetId], references: [id], onDelete: SetNull)
  category     Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  practiceGame Game?             @relation("PracticeGame", fields: [practiceGameId], references: [id], onDelete: SetNull)
  assignments  Assignment[]
  collections  CollectionVideo[]
  progress     VideoProgress[]

  @@index([schoolId, status])
}

model GameTemplate {
  key         String  @id // e.g. SPEAK_AND_ANSWER
  name        String
  description String
  available   Boolean @default(true)
  games       Game[]
}

model Game {
  id                 String        @id @default(cuid())
  schoolId           String
  teacherId          String
  templateKey        String
  title              String
  description        String        @default("")
  categoryId         String?
  topic              String        @default("")
  objective          String        @default("")
  level              String        @default("")
  instructions       String        @default("")
  instructionAudioId String?
  language           String        @default("es-419")
  difficulty         Int           @default(1)
  estimatedMinutes   Int?
  status             ContentStatus @default(DRAFT)
  settings           Json          @default("{}")
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher          Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  template         GameTemplate     @relation(fields: [templateKey], references: [key])
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  instructionAudio AudioAsset?      @relation("InstructionAudio", fields: [instructionAudioId], references: [id], onDelete: SetNull)
  items            GameItem[]
  assignments      Assignment[]
  attempts         StudentAttempt[]
  practiceFor      Video[]          @relation("PracticeGame")
  libraryResources GameResource[]

  @@index([schoolId, status])
  @@index([teacherId])
}

model GameItem {
  id           String  @id @default(cuid())
  gameId       String
  position     Int
  text         String  @default("")
  imageAssetId String?
  difficulty   Int     @default(1)
  // Template-specific fields: flashcard back/translation, diagram point (x, y in %), box label…
  data         Json    @default("{}")

  game      Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  image     MediaAsset? @relation("ItemImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  questions Question[]

  @@index([gameId, position])
}

model Question {
  id              String         @id @default(cuid())
  itemId          String
  prompt          String
  expectedAnswer  String
  evaluationMode  EvaluationMode @default(PHRASE)
  hint            String         @default("")
  // Optional support line in another language (e.g. "How do you spell your name?"), spoken first.
  supportText     String         @default("")
  supportLanguage String         @default("en-US")
  // Language the student answers in (null = the activity language). The recognizer uses this,
  // never the language(s) of the question.
  answerLanguage  String?
  supportAudioId  String?
  promptAudioId   String?
  hintAudioId     String?
  modelAudioId    String?

  item            GameItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  promptAudio     AudioAsset?       @relation("PromptAudio", fields: [promptAudioId], references: [id], onDelete: SetNull)
  hintAudio       AudioAsset?       @relation("HintAudio", fields: [hintAudioId], references: [id], onDelete: SetNull)
  modelAudio      AudioAsset?       @relation("ModelAudio", fields: [modelAudioId], references: [id], onDelete: SetNull)
  supportAudio    AudioAsset?       @relation("SupportAudio", fields: [supportAudioId], references: [id], onDelete: SetNull)
  acceptedAnswers AcceptedAnswer[]
  responses       StudentResponse[]
  progress        ProgressRecord[]

  @@index([itemId])
}

model AcceptedAnswer {
  id         String @id @default(cuid())
  questionId String
  text       String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Assignment {
  id           String    @id @default(cuid())
  schoolId     String
  teacherId    String
  gameId       String?
  videoId      String?
  collectionId String?
  // LextroSpeak tasks: a topic with the chosen library activities (pinned versions).
  topicId      String?
  title        String    @default("")
  instructions String    @default("")
  startsAt     DateTime  @default(now())
  dueAt        DateTime?
  maxAttempts  Int?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  school     School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher    Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  game       Game?                 @relation(fields: [gameId], references: [id], onDelete: Cascade)
  video      Video?                @relation(fields: [videoId], references: [id], onDelete: Cascade)
  collection Collection?           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  topic      Topic?                @relation(fields: [topicId], references: [id], onDelete: SetNull)
  recipients AssignmentRecipient[]
  attempts   StudentAttempt[]
  activities AssignmentActivity[]

  @@index([schoolId, active])
}

model AssignmentRecipient {
  id           String        @id @default(cuid())
  assignmentId String
  type         RecipientType
  classroomId  String?
  levelId      String?
  groupId      String?
  studentId    String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  classroom  Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  level      Level?     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  group      Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student    Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([classroomId])
  @@index([levelId])
  @@index([groupId])
  @@index([studentId])
}

model StudentAttempt {
  id                 String    @id @default(cuid())
  studentId          String
  gameId             String
  assignmentId       String?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  durationMs         Int?
  questionsPresented Int       @default(0)
  correctCount       Int       @default(0)
  incorrectCount     Int       @default(0)
  uncertainCount     Int       @default(0)
  hintsUsed          Int       @default(0)
  independentCount   Int       @default(0)

  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  game       Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  assignment Assignment?       @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  responses  StudentResponse[]

  @@index([studentId, assignmentId])
  @@index([assignmentId])
}

// One evaluated spoken answer. Audio is NOT stored; only the transcript and scoring data.
model StudentResponse {
  id            String          @id @default(cuid())
  attemptId     String
  questionId    String
  tryNumber     Int
  outcome       ResponseOutcome
  support       SupportLevel
  transcript    String          @default("")
  confidence    Float?
  language      String
  provider      String
  reason        String          @default("")
  score         Float?
  // True for the response that closed the question (correct, or moved on after the last try).
  endsQuestion  Boolean         @default(false)
  // Montessori feedback: correct after an own mistake, before any hint or model.
  selfCorrected Boolean         @default(false)
  // Montessori feedback: why the answer was not accepted (vocabulary, pronunciation, silence…).
  errorKind     String          @default("")
  createdAt     DateTime        @default(now())

  attempt  StudentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
}

// Latest mastery state of a student for one question / vocabulary item.
model ProgressRecord {
  id               String        @id @default(cuid())
  studentId        String
  questionId       String
  status           MasteryStatus
  independentCount Int           @default(0)
  guidedCount      Int           @default(0)
  practiceCount    Int           @default(0)
  lastSeenAt       DateTime      @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([studentId, questionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

// Words the spell checker must leave alone (proper names, invented words, specific vocabulary).
model KeepWord {
  id        String   @id @default(cuid())
  schoolId  String
  word      String
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, word])
}

// Ordered set of videos a teacher groups together (e.g. "Unit 3: Animals").
model Collection {
  id          String   @id @default(cuid())
  schoolId    String
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  videos      CollectionVideo[]
  assignments Assignment[]

  @@index([schoolId])
}

model CollectionVideo {
  collectionId String
  videoId      String
  position     Int

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  video      Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([collectionId, videoId])
}

// Where a student is in a video, so they can continue, and whether they finished it.
model VideoProgress {
  studentId   String
  videoId     String
  positionSec Float    @default(0)
  watchedSec  Float    @default(0)
  durationSec Float?
  completed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video   Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([studentId, videoId])
}

// One-time "forgot password" links. Only the SHA-256 of the token is stored; links expire
// after 30 minutes and are deleted when used.
model PasswordResetToken {
  id        String   @id // sha256 of the emailed token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Shared counters for sign-in / reset / speech limits, so limits hold across all server
// instances. The key is a SHA-256 hash (no raw emails or IP addresses are stored).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// ---------------- LextroSpeak: email, billing ----------------

model EmailVerificationToken {
  id        String   @id // sha256 of the emailed token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Administrator invitation for an email that has no account yet (or isn't verified).
model AdminInvite {
  id         String    @id // sha256 of the emailed token
  email      String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

// One row per automatic email that was claimed. The key makes each event send at most once
// (e.g. "welcome:<userId>", "purchase:<subscriptionId>", "payment:<invoiceId>").
model EmailLog {
  key     String   @id
  userId  String?
  kind    String
  to      String
  subject String
  status  String   @default("sent") // sent | failed
  sentAt  DateTime @default(now())

  @@index([userId])
}

// Stripe webhook events already processed (retries are acknowledged without redoing the work).
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model Subscription {
  id               String    @id // Stripe subscription id
  userId           String
  customerId       String
  status           String
  priceId          String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------- LextroSpeak: content library ----------------
// Platform-wide content managed by administrators. Teachers browse published content by grade
// and assign topics; students open the exact version that was assigned to them.

model Topic {
  id        String        @id @default(cuid())
  slug      String        @unique
  titleEn   String
  titleEs   String
  category  String        @default("Vocabulary")
  color     String        @default("#FF9F5A")
  // Built-in illustration key (e.g. "topic:animals") shown on the topic card.
  art       String        @default("")
  sortOrder Int           @default(0)
  status    ContentStatus @default(PUBLISHED)
  // Grade created by an administrator (Admin › Grades). Optional; topics may cover several bands.
  gradeId   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  grade       Grade?          @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  resources   TopicResource[]
  assignments Assignment[]

  @@index([gradeId])
}

// Grades the administrator creates ("Add Grade"). nameKey is the trimmed, lower-cased name so
// "Grade 1" and " grade 1 " can't both exist.
model Grade {
  id        String   @id @default(cuid())
  name      String
  nameKey   String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  topics Topic[]
}

// Library resources added to an activity (Game) with "Add from Library". Removing the link never
// deletes the resource from the library.
model GameResource {
  gameId     String
  resourceId String
  position   Int

  game     Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  resource LibraryResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([gameId, resourceId])
  @@index([resourceId])
}

model LibraryResource {
  id               String        @id @default(cuid())
  kind             ResourceKind
  title            String
  description      String        @default("")
  status           ContentStatus @default(DRAFT)
  grades           GradeBand[]
  // Editable content (what the editor saves). Publishing copies it into a new version.
  draft            Json          @default("{}")
  currentVersionId String?       @unique
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  currentVersion ResourceVersion?     @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ResourceVersion[]    @relation("Versions")
  topics         TopicResource[]
  activities     AssignmentActivity[]
  games          GameResource[]

  @@index([status])
}

// Immutable snapshot of a published resource. Assignments point at a version, so later edits
// never change (or erase) what students already have and the attempts they made.
model ResourceVersion {
  id         String   @id @default(cuid())
  resourceId String
  number     Int
  title      String
  content    Json
  // Every library file the content references (used for access checks).
  fileIds    String[]
  createdAt  DateTime @default(now())

  resource   LibraryResource      @relation("Versions", fields: [resourceId], references: [id], onDelete: Cascade)
  currentOf  LibraryResource?     @relation("CurrentVersion")
  activities AssignmentActivity[]

  @@unique([resourceId, number])
}

model TopicResource {
  topicId    String
  resourceId String
  position   Int

  topic    Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  resource LibraryResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([topicId, resourceId])
  @@index([resourceId])
}

// Uploaded file (video, song, PDF, image, audio). Stored privately; served after an access check.
model LibraryFile {
  id           String   @id @default(cuid())
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int      @default(0)
  originalName String
  ready        Boolean  @default(false)
  uploadedById String?
  createdAt    DateTime @default(now())
}

model AssignmentActivity {
  id           String @id @default(cuid())
  assignmentId String
  resourceId   String
  versionId    String
  position     Int

  assignment Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  resource   LibraryResource    @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  version    ResourceVersion    @relation(fields: [versionId], references: [id], onDelete: Restrict)
  progress   ActivityProgress[]

  @@index([assignmentId])
  @@index([resourceId])
}

model ActivityProgress {
  id          String    @id @default(cuid())
  activityId  String
  studentId   String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  score       Int?
  total       Int?

  activity AssignmentActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student  Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([activityId, studentId])
  @@index([studentId])
}

// ---------------- Montessori Intelligent Feedback Engine ----------------

enum ProgressLevel {
  EXPLORING
  DEVELOPING
  PROGRESSING
  PROFICIENT
  EXTENDING
}

// Settings → Montessori Feedback (one row, id "platform"). The JSON is validated by
// src/lib/montessori/config.ts; missing fields fall back to defaults.
model MontessoriSettings {
  id          String   @id
  config      Json     @default("{}")
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// One student's evidence for one skill (a word or phrase), across every activity that practises
// it. skillKey = "vocab:<language>:<normalized answer>", so "perro" in flashcards and in a
// speaking game is the same skill. The level is computed from the evidence; a teacher may set
// teacherLevel, which then wins until cleared.
model SkillProgress {
  id                 String         @id @default(cuid())
  studentId          String
  skillKey           String
  label              String
  topic              String         @default("")
  attempts           Int            @default(0)
  correct            Int            @default(0)
  independentCorrect Int            @default(0)
  missed             Int            @default(0)
  hintsUsed          Int            @default(0)
  selfCorrections    Int            @default(0)
  streak             Int            @default(0)
  independentDays    String[]       @default([])
  contexts           String[]       @default([])
  level              ProgressLevel  @default(EXPLORING)
  teacherLevel       ProgressLevel?
  teacherNote        String         @default("")
  teacherUpdatedAt   DateTime?
  teacherUpdatedById String?
  lastActivity       String         @default("")
  lastNeededHelpAt   DateTime?
  lastPracticedAt    DateTime       @default(now())
  createdAt          DateTime       @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillKey])
  @@index([studentId, topic])
}
